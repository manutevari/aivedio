NODE_ENV=development
PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=true
DATABASE_URL=
REDIS_URL=
TAVILY_API_KEY=

# Authentication
AIVEDIO_SESSION_SECRET=
AIVEDIO_BOOTSTRAP_ADMIN_KEY=
AIVEDIO_ALLOW_SELF_REGISTRATION=false
AIVEDIO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8501
AIVEDIO_WEB_URL=http://localhost:5173
AIVEDIO_SITE_URL=http://localhost:5173

# Password-reset email (Resend)
RESEND_API_KEY=
AIVEDIO_EMAIL_FROM=

# Agent pipeline (server-side only; never place in browser or Streamlit secrets)
OPENROUTER_AGENT_MODEL=openrouter/auto

# Optional research
TAVILY_API_KEY=

# LangSmith observability (optional, opt-in)
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aivedio-agent-pipeline
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional trace redaction (recommended for sensitive briefs)
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
