# Internal Python LangGraph service only. Never expose these values to browser clients.
DATABASE_URL=postgresql://user:password@localhost:5432/aivedio
AIVEDIO_INTERNAL_API_TOKEN=replace-with-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=openrouter/auto

# Optional observability; disabled unless explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aivedio-agent-pipeline
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
