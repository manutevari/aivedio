{
  "name": "@aivedio/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:migrate": "tsx scripts/migrate.ts",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:security": "tsx --test scripts/security-config.test.ts scripts/auth-rate-limit.test.ts",
    "lint": "echo 'Linting not configured yet'",
    "test:agents": "tsx --test scripts/agent-validation.test.ts"
  },
  "dependencies": {
    "@aivedio/core": "workspace:*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "@langchain/core": "^1.5.0",
    "@langchain/openai": "^1.8.5",
    "langsmith": "^0.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
