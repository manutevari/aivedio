{
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @aivedio/api build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "dist",
  "functions": { "index.ts": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.ts" }]
}
